<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>{% block title %}CinéTech{% endblock %}</title>

        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
        >
    </head>

    <body class="bg-light">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand fw-bold" href="{{ path('app_home') }}">
                    CinéTech
                </a>

                <div class="navbar-nav">
                    <a class="nav-link" href="{{ path('app_home') }}">
                        Accueil
                    </a>

                    <a class="nav-link" href="{{ path('app_movie_index') }}">
                        Catalogue
                    </a>

                    <a class="nav-link" href="{{ path('app_movie_new') }}">
                        Ajouter un film
                    </a>

                    <a class="nav-link" href="{{ path('app_category_index') }}">
                        Gérer les catégories
                    </a>
                </div>
            </div>
        </nav>

        {% for label, messages in app.flashes %}
            {% set alertClass = label in ['success', 'warning', 'danger', 'info']
                ? label
                : 'info'
            %}

            {% for message in messages %}
                <div class="container mt-3">
                    <div class="alert alert-{{ alertClass }}" role="alert">
                        {{ message }}
                    </div>
                </div>
            {% endfor %}
        {% endfor %}

        <main>
            {% block body %}{% endblock %}
        </main>

        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        ></script>
    </body>
</html>